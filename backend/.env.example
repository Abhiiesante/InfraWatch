# Development environment template for InfraWatch Backend

# Node Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://infrawatch:infrawatch@localhost:5432/infrawatch_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (Generate: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-secret-minimum-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-secret-minimum-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AWS Configuration (for S3 file uploads)
AWS_REGION=us-east-1
AWS_S3_BUCKET=infrawatch-dev
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Email (AWS SES)
AWS_SES_REGION=us-east-1
SENDER_EMAIL=noreply@infrawatch.dev
