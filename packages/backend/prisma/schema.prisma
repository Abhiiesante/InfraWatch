generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ORGANIZATION (Tenant)
// ============================================================================

model Organization {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  domain    String?  @unique @db.VarChar(255)
  plan      String   @default("STARTER") @db.VarChar(50)
  logoUrl   String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  users             User[]
  assets            Asset[]
  cameras           Camera[]
  assetTypes        AssetType[]
  inspections       Inspection[]
  incidents         Incident[]
  reports           Report[]
  notifications     Notification[]
  incidentCategories IncidentCategory[]
  anomalies         AnomalyDetection[]
  aiConfig          TenantAIConfig?
  predictions       AssetPrediction[]
  telemetryReadings TelemetryReading[]
  sensorRules       SensorRule[]
  workOrders        WorkOrder[]
  scadaActuators    ScadaActuator[]
  drones            Drone[]
  droneMissions     DroneMission[]
  bimModels         BimModel[]
  bimHotspots       BimHotspot[]
  aiModels          AIModel[]
  aiPredictions     AIPrediction[]
  aiEvents          AIEvent[]
  modelFeedbacks    ModelFeedback[]
  
  // Warehouse & Logistics Models (Phase 4)
  facilityZones     FacilityZone[]
  storageRacks      StorageRack[]
  logisticsFleets   LogisticsFleet[]
  cvSafetyMetrics   CVSafetyMetricGold[]

  // Video Inspection Intelligence (Agentic AI)
  inspectionVideos  InspectionVideo[]
  videoFindings     VideoFinding[]

  @@map("organizations")
}

// ============================================================================
// USER
// ============================================================================

model User {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  name          String   @db.VarChar(255)
  email         String   @db.VarChar(320)
  hashedPassword String  @db.Text
  role          String   @default("INSPECTOR") @db.VarChar(20)
  avatarUrl     String?  @db.Text
  phone         String?  @db.VarChar(20)
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime? @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAssets Asset[] @relation("AssetCreatedBy")
  inspections  Inspection[]
  incidents    Incident[]
  incidentAssignments IncidentAssignment[]
  incidentComments IncidentComment[] @relation("UserIncidentComments")
  auditLogs    AuditLog[]
  notifications Notification[]
  reviewedAnomalies AnomalyDetection[] @relation("AnomalyReviewer")
  assignedWorkOrders WorkOrder[] @relation("WorkOrderAssignedTo")
  aiReviews          AIReview[] @relation("UserAIReviews")
  modelFeedbacks     ModelFeedback[] @relation("UserModelFeedbacks")
  uploadedVideos     InspectionVideo[] @relation("UserUploadedVideos")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, role])
  @@map("users")
}

// ============================================================================
// ASSET_TYPE
// ============================================================================

model AssetType {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  name      String   @db.VarChar(255)
  description String? @db.Text
  icon      String?  @db.VarChar(50)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets   Asset[]

  @@index([tenantId])
  @@map("asset_types")
}

// ============================================================================
// ASSET
// ============================================================================

model Asset {
  id                Int      @id @default(autoincrement())
  tenantId          Int
  assetTypeId       Int
  createdById       Int
  name              String   @db.VarChar(255)
  description       String?  @db.Text
  latitude          Decimal? @db.Decimal(10, 8)
  longitude         Decimal? @db.Decimal(11, 8)
  address           String?  @db.VarChar(500)
  metadata          Json?    @db.JsonB
  status            String   @default("ACTIVE") @db.VarChar(50)
  healthScore       Int      @default(100)
  lastPredictionAt  DateTime? @db.Timestamptz(6)
  deletedAt         DateTime? @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetType   AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Restrict)
  createdBy   User @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cameras     Camera[]
  inspections Inspection[]
  incidents   Incident[]
  predictions AssetPrediction[]
  telemetryReadings TelemetryReading[]
  sensorRules       SensorRule[]
  workOrders        WorkOrder[]
  scadaActuators    ScadaActuator[]
  bimModels         BimModel[]
  aiPredictions     AIPrediction[] @relation("AssetAIPredictions")
  aiEvents          AIEvent[] @relation("AssetAIEvents")
  facilityZones     FacilityZone[]
  inspectionVideos  InspectionVideo[]

  @@index([tenantId])
  @@index([assetTypeId])
  @@map("assets")
}

// ============================================================================
// CAMERA
// ============================================================================

model Camera {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  assetId         Int
  name            String   @db.VarChar(255)
  cameraType      String   @db.VarChar(100)
  rtspUrl         String   @db.Text
  ipAddress       String?  @db.VarChar(45)
  config          Json?    @db.JsonB
  status          String   @default("OFFLINE") @db.VarChar(50)
  installationDate DateTime? @db.Date
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset       Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inspectionImages InspectionImage[]
  anomalies   AnomalyDetection[]
  aiPredictions AIPrediction[]
  cvSafetyMetrics CVSafetyMetricGold[]

  @@index([tenantId])
  @@index([assetId])
  @@map("cameras")
}

// ============================================================================
// INSPECTION
// ============================================================================

model Inspection {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  assetId         Int
  inspectorId     Int
  scheduledDate   DateTime @db.Date
  completedAt     DateTime? @db.Timestamptz(6)
  notes           String?  @db.Text
  status          String   @default("SCHEDULED") @db.VarChar(50)
  isPredictive    Boolean  @default(false)
  predictionId    Int?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset       Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inspector   User @relation(fields: [inspectorId], references: [id], onDelete: Restrict)
  inspectionImages InspectionImage[]
  prediction  AssetPrediction? @relation(fields: [predictionId], references: [id], onDelete: SetNull)
  droneMissions DroneMission[]
  inspectionVideos InspectionVideo[]

  @@index([tenantId])
  @@index([assetId])
  @@index([inspectorId])
  @@map("inspections")
}

// ============================================================================
// INSPECTION_IMAGE
// ============================================================================

model InspectionImage {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  inspectionId  Int
  cameraId      Int?
  imageUrl      String   @db.Text
  caption       String?  @db.VarChar(255)
  metadata      Json?    @db.JsonB
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  inspection  Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  camera      Camera? @relation(fields: [cameraId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([inspectionId])
  @@index([cameraId])
  @@map("inspection_images")
}

// ============================================================================
// INSPECTION_VIDEO (Video-Based Inspection Intelligence)
// ============================================================================

model InspectionVideo {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  inspectionId    Int?
  assetId         Int
  uploadedById    Int
  fileName        String   @db.VarChar(500)
  fileUrl         String   @db.Text
  fileSizeBytes   BigInt?
  durationSeconds Decimal? @db.Decimal(10, 2)
  sourceType      String   @default("UPLOAD") @db.VarChar(50) // UPLOAD, DRONE, PHONE_CAPTURE
  status          String   @default("PENDING") @db.VarChar(50) // PENDING, EXTRACTING, ANALYZING, COMPLETED, FAILED
  frameCount      Int      @default(0)
  samplingRateFps Decimal  @default(1.0) @db.Decimal(5, 2)
  targetFrameBudget Int    @default(45)
  analysisConfig  Json?    @db.JsonB
  summary         String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inspection   Inspection?  @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("UserUploadedVideos", fields: [uploadedById], references: [id], onDelete: Restrict)
  findings     VideoFinding[]

  @@index([tenantId])
  @@index([assetId])
  @@index([inspectionId])
  @@index([status])
  @@map("inspection_videos")
}

// ============================================================================
// VIDEO_FINDING (Defect Detections Mapped to Video Frames)
// ============================================================================

model VideoFinding {
  id                Int      @id @default(autoincrement())
  tenantId          Int
  videoId           Int
  frameIndex        Int
  frameTimestamp    Decimal  @db.Decimal(10, 3) // seconds into video
  frameImageUrl     String?  @db.Text
  defectType        String   @db.VarChar(255)
  confidence        Decimal  @db.Decimal(5, 2)
  severity          String   @default("MEDIUM") @db.VarChar(50) // CRITICAL, HIGH, MEDIUM, LOW
  bbox              Json     @db.JsonB // [x, y, w, h] in % or px
  rawPrediction     Json?    @db.JsonB
  triageNotes       String?  @db.Text
  status            String   @default("PENDING_REVIEW") @db.VarChar(50) // PENDING_REVIEW, CONFIRMED, DISMISSED
  aiEventId         Int?     @unique
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  organization Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  video        InspectionVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  aiEvent      AIEvent?        @relation(fields: [aiEventId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([videoId])
  @@index([status])
  @@index([severity])
  @@map("video_findings")
}

// ============================================================================
// INCIDENT CATEGORY (Phase 2)
// ============================================================================

model IncidentCategory {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incidents    Incident[]

  @@index([tenantId])
  @@map("incident_categories")
}

// ============================================================================
// INCIDENT
// ============================================================================

model Incident {
  id                  Int      @id @default(autoincrement())
  tenantId            Int
  assetId             Int?
  reporterId          Int
  categoryId          Int?
  title               String   @db.VarChar(255)
  description         String?  @db.Text
  source              String   @default("MANUAL") @db.VarChar(50)
  severity            String   @default("MEDIUM") @db.VarChar(50)
  status              String   @default("OPEN") @db.VarChar(50)
  attachmentUrls      String[]
  
  // Phase 2 AI Triage Fields
  aiSuggestedSeverity String?  @db.VarChar(50)
  aiSuggestedCategory String?  @db.VarChar(255)
  aiConfidence        Decimal? @db.Decimal(5, 2)
  aiTriagedAt         DateTime? @db.Timestamptz(6)

  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset        Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  reporter     User @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  category     IncidentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignments  IncidentAssignment[]
  comments     IncidentComment[]
  anomaly      AnomalyDetection?
  workOrders   WorkOrder[]
  aiEvent      AIEvent? @relation("IncidentAIEvent")

  @@index([tenantId])
  @@index([assetId])
  @@index([reporterId])
  @@map("incidents")
}

// ============================================================================
// INCIDENT_ASSIGNMENT
// ============================================================================

model IncidentAssignment {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  incidentId  Int
  assignedTo  Int
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [assignedTo], references: [id], onDelete: Cascade)

  @@unique([incidentId, assignedTo])
  @@index([tenantId])
  @@map("incident_assignments")
}

// ============================================================================
// INCIDENT_COMMENT
// ============================================================================

model IncidentComment {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  incidentId  Int
  authorId    Int
  content     String   @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author      User @relation("UserIncidentComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([incidentId])
  @@map("incident_comments")
}

// ============================================================================
// NOTIFICATION (Phase 1)
// ============================================================================

model Notification {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  userId      Int
  type        String   @db.VarChar(50)
  title       String   @db.VarChar(255)
  message     String   @db.Text
  isRead      Boolean  @default(false)
  entityType  String?  @db.VarChar(50)
  entityId    Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ============================================================================
// ANOMALY DETECTION (Phase 3 Computer Vision)
// ============================================================================

model AnomalyDetection {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  cameraId      Int
  imageUrl      String   @db.Text
  detections    Json     @db.JsonB
  status        String   @default("PENDING_REVIEW") @db.VarChar(50)
  confidence    Decimal  @db.Decimal(5, 2)
  reviewedById  Int?
  reviewedAt    DateTime? @db.Timestamptz(6)
  incidentId    Int?     @unique
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  camera      Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  reviewer    User? @relation("AnomalyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  incident    Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([cameraId])
  @@index([status])
  @@map("anomaly_detections")
}

// ============================================================================
// GOLD LAYER SAFETY METRICS (Local Fallback)
// ============================================================================

model CVSafetyMetricGold {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  cameraId        Int
  timestamp       DateTime @db.Timestamptz(6)
  totalDetections Int      @default(0)
  zoneViolations  Int      @default(0)
  maxActiveAMRs   Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  organization    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  camera          Camera       @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([cameraId])
  @@index([timestamp])
  @@map("cv_safety_metrics_gold")
}

// ============================================================================
// TENANT AI CONFIG (Phase 3)
// ============================================================================

model TenantAIConfig {
  id                    Int      @id @default(autoincrement())
  tenantId              Int      @unique
  cvEnabled             Boolean  @default(true)
  cvConfidenceThreshold Decimal  @default(0.75) @db.Decimal(3, 2)
  nlpEnabled            Boolean  @default(true)
  aiProvider            String   @default("GEMINI") @db.VarChar(50)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_ai_configs")
}

// ============================================================================
// ASSET PREDICTION (Phase 4 Predictive Maintenance)
// ============================================================================

model AssetPrediction {
  id                           Int      @id @default(autoincrement())
  tenantId                     Int
  assetId                      Int
  failureProbability           Decimal  @db.Decimal(5, 2)
  predictedFailureDate         DateTime @db.Date
  recommendedAction            String   @db.Text
  confidence                   Decimal  @db.Decimal(5, 2)
  analysisData                 Json?    @db.JsonB
  autoScheduledInspectionId   Int?
  status                       String   @default("ACTIVE") @db.VarChar(50)
  createdAt                    DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset        Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inspections  Inspection[]

  @@index([tenantId])
  @@index([assetId])
  @@map("asset_predictions")
}

// ============================================================================
// REPORT (Phase 4 Asynchronous Reporting)
// ============================================================================

model Report {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  title        String   @db.VarChar(255)
  type         String   @db.VarChar(50)
  status       String   @default("COMPLETED") @db.VarChar(50) // GENERATING, COMPLETED, FAILED
  format       String   @default("PDF") @db.VarChar(20) // PDF, CSV
  downloadUrl  String?  @db.Text
  data         Json?    @db.JsonB
  summary      String?  @db.Text
  generatedAt  DateTime @default(now()) @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("reports")
}

// ============================================================================
// AUDIT_LOG
// ============================================================================

model AuditLog {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  userId      Int
  action      String   @db.VarChar(50)
  entity      String   @db.VarChar(50)
  entityId    Int?
  changes     Json?    @db.JsonB
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// TELEMETRY READING (Phase 5 IoT Real-time Stream)
// ============================================================================

model TelemetryReading {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  assetId     Int
  sensorType  String   @db.VarChar(50)
  value       Decimal  @db.Decimal(10, 2)
  unit        String   @db.VarChar(20)
  isAnomaly   Boolean  @default(false)
  timestamp   DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset        Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assetId])
  @@index([timestamp])
  @@map("telemetry_readings")
}

// ============================================================================
// SENSOR RULE (Phase 5 Threshold Rules)
// ============================================================================

model SensorRule {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  assetId      Int?
  sensorType   String   @db.VarChar(50)
  minThreshold Decimal? @db.Decimal(10, 2)
  maxThreshold Decimal? @db.Decimal(10, 2)
  action       String   @default("ALERT") @db.VarChar(50)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset        Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sensor_rules")
}

// ============================================================================
// WORK ORDER (Phase 6 SLA & Dispatch)
// ============================================================================

model WorkOrder {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  incidentId   Int?
  assetId      Int
  assignedToId Int?
  title        String   @db.VarChar(255)
  description  String?  @db.Text
  priority     String   @default("MEDIUM") @db.VarChar(50)
  status       String   @default("PENDING") @db.VarChar(50)
  slaDeadline  DateTime @db.Timestamptz(6)
  completedAt  DateTime? @db.Timestamptz(6)
  signatureUrl String?  @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incident     Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  asset        Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedTo   User? @relation("WorkOrderAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([assignedToId])
  @@map("work_orders")
}

// ============================================================================
// SCADA ACTUATOR
// ============================================================================

model ScadaActuator {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  assetId         Int
  name            String   @db.VarChar(255)
  type            String   @db.VarChar(100) // e.g., CIRCUIT_BREAKER, HYDRAULIC_SURGE_VALVE
  status          String   @default("ENGAGED") @db.VarChar(50) // ENGAGED, DISENGAGED
  lastCommandAt   DateTime? @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset        Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assetId])
  @@map("scada_actuators")
}

// ============================================================================
// DRONE & DRONE MISSION
// ============================================================================

model Drone {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  name            String   @db.VarChar(255)
  model           String   @db.VarChar(255)
  status          String   @default("CHARGING_DOCK") @db.VarChar(50)
  batteryPercent  Int      @default(100)
  currentLat      Decimal? @db.Decimal(10, 8)
  currentLng      Decimal? @db.Decimal(11, 8)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  missions     DroneMission[]

  @@index([tenantId])
  @@map("drones")
}

model DroneMission {
  id                Int      @id @default(autoincrement())
  tenantId          Int
  droneId           Int
  inspectionId      Int?
  status            String   @default("PENDING") @db.VarChar(50) // PENDING, EXECUTING, COMPLETED
  startTime         DateTime? @db.Timestamptz(6)
  endTime           DateTime? @db.Timestamptz(6)
  waypointsCompleted Int      @default(0)
  totalWaypoints    Int      @default(20)
  currentAltitude   Decimal? @db.Decimal(8, 2)
  currentSpeed      Decimal? @db.Decimal(8, 2)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  drone        Drone @relation(fields: [droneId], references: [id], onDelete: Cascade)
  inspection   Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([droneId])
  @@index([inspectionId])
  @@map("drone_missions")
}

// ============================================================================
// BIM MODEL & HOTSPOTS
// ============================================================================

model BimModel {
  id                  Int      @id @default(autoincrement())
  tenantId            Int
  assetId             Int
  fileName            String   @db.VarChar(500)
  bimFormat           String   @db.VarChar(100) // e.g. IFC4_DYNAMIC_MESH, IFC4_FUSION_TOKAMAK_ADVANCED_BIM
  bimType             String   @db.VarChar(100) // CIVIL_INFRASTRUCTURE, TOKAMAK_FUSION_REACTOR
  elementCount        Int      @default(0)
  structuralStressMPa Decimal? @db.Decimal(10, 2)
  thermalGradientC    Decimal? @db.Decimal(10, 2)
  healthRating        String   @default("OPTIMAL") @db.VarChar(50)
  uploadDate          DateTime @default(now()) @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)
  
  // Specific physics fields for Fusion Reactors
  magneticFieldTesla  Decimal? @db.Decimal(10, 2)
  plasmaTempMillionC  Decimal? @db.Decimal(10, 2)
  cryostatVacuumPa    String?  @db.VarChar(50)
  activeCoils         Int?
  totalCoils          Int?

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset        Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  hotspots     BimHotspot[]

  @@index([tenantId])
  @@index([assetId])
  @@map("bim_models")
}

model BimHotspot {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  bimModelId      Int
  elementId       String   @db.VarChar(255)
  stressLevel     String   @db.VarChar(50) // NOMINAL, ELEVATED, HIGH, CRITICAL
  valueMPa        Decimal  @db.Decimal(10, 2)
  location        String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bimModel     BimModel @relation(fields: [bimModelId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bimModelId])
  @@map("bim_hotspots")
}

// ============================================================================
// AI PLATFORM INTEGRATION (Phase 1)
// ============================================================================

model AIModel {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  modelType       String   @db.VarChar(100) // CV, NLP, PREDICTIVE, ANOMALY
  status          String   @default("TRAINING") @db.VarChar(50)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  organization    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions        AIModelVersion[]

  @@index([tenantId])
  @@map("ai_models")
}

model AIModelVersion {
  id              Int      @id @default(autoincrement())
  modelId         Int
  version         String   @db.VarChar(50)
  status          String   @default("CANDIDATE") @db.VarChar(50) // CANDIDATE, CHAMPION, DEPRECATED
  metrics         Json?    @db.JsonB
  parameters      Json?    @db.JsonB
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  model           AIModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  predictions     AIPrediction[]
  events          AIEvent[]

  @@index([modelId])
  @@map("ai_model_versions")
}

model AIPrediction {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  assetId         Int?
  cameraId        Int?
  modelVersionId  Int
  predictionType  String   @db.VarChar(100) // ANOMALY, CLASSIFICATION, DETECTION
  label           String   @db.VarChar(255)
  confidence      Decimal  @db.Decimal(5, 2)
  metadata        Json?    @db.JsonB
  sourceUri       String?  @db.Text
  occurredAt      DateTime @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  organization    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset           Asset?       @relation("AssetAIPredictions", fields: [assetId], references: [id], onDelete: SetNull)
  camera          Camera?      @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  modelVersion    AIModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  feedbacks       ModelFeedback[]

  @@index([tenantId])
  @@index([assetId])
  @@index([modelVersionId])
  @@map("ai_predictions")
}

model AIEvent {
  id                  Int      @id @default(autoincrement())
  tenantId            Int
  assetId             Int?
  modelVersionId      Int?
  eventType           String   @db.VarChar(100)
  severity            String   @default("MEDIUM") @db.VarChar(50)
  aggregateConfidence Decimal  @db.Decimal(5, 2)
  status              String   @default("NEW") @db.VarChar(50) // NEW, REVIEWED, DISMISSED, INCIDENT_CREATED
  firstDetectedAt     DateTime @db.Timestamptz(6)
  lastDetectedAt      DateTime @db.Timestamptz(6)
  predictionCount     Int      @default(1)
  incidentId          Int?     @unique

  organization    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset           Asset?       @relation("AssetAIEvents", fields: [assetId], references: [id], onDelete: SetNull)
  modelVersion    AIModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)
  incident        Incident?    @relation("IncidentAIEvent", fields: [incidentId], references: [id], onDelete: SetNull)
  reviews         AIReview[]
  videoFinding    VideoFinding?

  @@index([tenantId])
  @@index([assetId])
  @@index([status])
  @@map("ai_events")
}

model AIReview {
  id              Int      @id @default(autoincrement())
  eventId         Int
  reviewerId      Int
  decision        String   @db.VarChar(50) // CONFIRMED, DISMISSED, CORRECTED, ESCALATED
  correctedLabel  String?  @db.VarChar(255)
  notes           String?  @db.Text
  reviewedAt      DateTime @default(now()) @db.Timestamptz(6)

  event           AIEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reviewer        User     @relation("UserAIReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([reviewerId])
  @@map("ai_reviews")
}

model ModelFeedback {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  predictionId    Int?
  reviewerId      Int
  rating          Int?     @db.SmallInt // 1 to 5
  correctedLabel  String?  @db.VarChar(255)
  feedbackText    String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  organization    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prediction      AIPrediction? @relation(fields: [predictionId], references: [id], onDelete: SetNull)
  reviewer        User     @relation("UserModelFeedbacks", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([predictionId])
  @@map("model_feedbacks")
}

// ============================================================================
// WAREHOUSE & LOGISTICS OPERATIONS (Option B Vertical Expansion)
// ============================================================================

model FacilityZone {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  assetId     Int      // The overall Warehouse building
  name        String   @db.VarChar(255) // e.g. "Loading Dock A", "High-bay Storage"
  zoneType    String   @db.VarChar(100) // e.g. "PEDESTRIAN", "FORKLIFT_ONLY", "MIXED"
  polygonGeom Json?    @db.JsonB // Spatial bounds for geo-fencing
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  storageRacks StorageRack[]

  @@index([tenantId])
  @@index([assetId])
  @@map("facility_zones")
}

model StorageRack {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  facilityZoneId  Int
  name            String   @db.VarChar(255) // e.g. "Rack A1"
  capacityWeight  Float?
  structuralHealth Float   @default(100.0) // 0-100 score
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  organization  Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facilityZone  FacilityZone @relation(fields: [facilityZoneId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([facilityZoneId])
  @@map("storage_racks")
}

model LogisticsFleet {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  name         String   @db.VarChar(255) // e.g. "Kiva-AMR-001"
  vehicleType  String   @db.VarChar(100) // e.g. "AMR", "FORKLIFT", "PALLET_JACK"
  status       String   @default("ACTIVE") @db.VarChar(50)
  lastKnownLat Float?
  lastKnownLng Float?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("logistics_fleets")
}
