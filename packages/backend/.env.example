# Development environment template for InfraWatch Backend

# Node Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://infrawatch:infrawatch@localhost:5432/infrawatch_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (Generate: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-secret-minimum-32-characters-here-1234567890
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-secret-minimum-32-characters-here
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AWS Configuration (for S3 file uploads)
AWS_REGION=us-east-1
AWS_S3_BUCKET=infrawatch-dev
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Email (AWS SES)
AWS_SES_REGION=us-east-1
SENDER_EMAIL=noreply@infrawatch.dev

# ---------------------------------------------------------------------------
# Integration Keys — Real Mode
# Each key below enables a real integration. Without it, the corresponding
# subsystem operates in clearly-labeled SIMULATED mode.
# ---------------------------------------------------------------------------

# Databricks (Data Lake sync — asset/incident/telemetry/CV events)
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Computer Vision — Roboflow real-time object detection (without this, CV Daemon emits simulated bounding boxes)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=infrawatch-safety/1
# Controls inference throttle per camera (in milliseconds) to protect API quota
CV_INFERENCE_INTERVAL_MS=1000

# Vision Model — custom ML endpoint for frame-level defect analysis (without this, vision engine emits simulated results)
VISION_MODEL_ENDPOINT=

# LLM — Incident Copilot AI analysis via Google Gemini (without this, Copilot returns mock responses)
GEMINI_API_KEY=
